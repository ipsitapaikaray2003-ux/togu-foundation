# ===================================================
# TOGU Foundation Backend Environment Configuration
# ===================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# ---------------------------------------------------
# Option A: Local Development (XAMPP / MySQL Workbench)
# ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=togu_foundation

# ---------------------------------------------------
# Option B: Hostinger Production Database Settings
# (Obtained from Hostinger hPanel -> Databases -> MySQL Databases)
# ---------------------------------------------------
# DB_HOST=localhost (or Hostinger MySQL IP if connecting remotely)
# DB_PORT=3306
# DB_USER=u123456789_togu_user
# DB_PASSWORD=your_strong_hostinger_db_password
# DB_NAME=u123456789_togu_foundation

# ---------------------------------------------------
# JWT Authentication Secret & Expiry
# ---------------------------------------------------
JWT_SECRET=togu_foundation_secure_jwt_secret_key_2026_!@#$%^
JWT_EXPIRES_IN=7d

# ---------------------------------------------------
# CORS Allowed Origins
# Add your production domain when deploying to Hostinger
# e.g.: https://togufoundation.org,http://localhost:5174
# ---------------------------------------------------
CLIENT_URL=http://localhost:5174,http://localhost:5173,https://togufoundation.org
