# ===================================================
# TOGU Foundation Backend Environment Configuration
# ===================================================

# Server Configuration
PORT=5001
NODE_ENV=production

# ---------------------------------------------------
# Option A: Local Development (XAMPP / MySQL Workbench)
# ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=togu_foundation
DB_SSL=false

# ---------------------------------------------------
# Option B: Cloud MySQL (Aiven / TiDB / Railway for Render)
# Set DB_SSL=true if required by cloud provider
# Or provide DATABASE_URL=mysql://user:pass@host:port/dbname
# ---------------------------------------------------
# DB_HOST=mysql-xxxx-togufoundation.aivencloud.com
# DB_PORT=18456
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_NAME=defaultdb
# DB_SSL=true

# ---------------------------------------------------
# Option C: Hostinger Remote MySQL
# (Hostinger hPanel -> Databases -> Remote MySQL -> Allow %)
# ---------------------------------------------------
# DB_HOST=sqlxxx.main-hosting.eu
# DB_PORT=3306
# DB_USER=u123456789_togu_user
# DB_PASSWORD=your_strong_hostinger_db_password
# DB_NAME=u123456789_togu_foundation
# DB_SSL=false

# ---------------------------------------------------
# JWT Authentication Secret & Expiry
# ---------------------------------------------------
JWT_SECRET=togu_foundation_secure_jwt_secret_key_2026_!@#$%^
JWT_EXPIRES_IN=7d

# ---------------------------------------------------
# CORS Allowed Origins (Comma separated)
# ---------------------------------------------------
CLIENT_URL=http://localhost:5174,http://localhost:5173,https://*.vercel.app

