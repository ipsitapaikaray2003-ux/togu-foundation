{
  "name": "togu-foundation-backend",
  "version": "1.0.0",
  "description": "TOGU Foundation NGO Management Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node -e \"import('./database/initDb.js').then(m => m.autoInitializeDatabase()).then(() => process.exit(0))\"",
    "seed": "node database/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.19.1"
  }
}
